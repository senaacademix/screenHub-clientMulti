{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenHubClient",
  "version": "1.0.0",
  "identifier": "com.screenhub.kiosk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ScreenHub Client Kiosk",
        "width": 1920,
        "height": 1080,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
